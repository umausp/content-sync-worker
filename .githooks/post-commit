#!/usr/bin/env bash
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Post-commit refresh: cannot determine repository root." >&2
  exit 0
}

refresh_script="$(dirname "$repo_root")/agyata-workspace-rag/scripts/post-commit-refresh.sh"
if [[ ! -x "$refresh_script" ]]; then
  echo "Post-commit refresh: shared refresh script is missing or not executable: $refresh_script" >&2
  exit 0
fi

"$refresh_script" "$repo_root"
